# Server Mode: 'stdio' or 'http'
MCP_MODE=stdio

# HTTP Mode Settings (only needed if MCP_MODE=http)
PORT=3000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# GitHub OAuth (only needed if MCP_MODE=http)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# Session Secret (only needed if MCP_MODE=http)
SESSION_SECRET=your_random_secret_key_here

# Optional: Allowed GitHub Users/Organizations
# Leave empty to allow all authenticated users
ALLOWED_GITHUB_USERS=username1,username2
ALLOWED_GITHUB_ORGS=org1,org2
